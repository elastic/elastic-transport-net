<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <IsTestProject>True</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Nullean.VsTest.Pretty.TestLogger" VersionOverride="0.4.0" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Condition="'$(TargetFramework)' != 'net481'" Include="Soenneker.Utils.AutoBogus" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Elastic.Transport.VirtualizedCluster\Elastic.Transport.VirtualizedCluster.csproj" />
    <ProjectReference Include="..\Elastic.Transport.Tests.SharedComponents\Elastic.Transport.Tests.SharedComponents.csproj" />
  </ItemGroup>

  <!-- Opt-in: test the library's netstandard2.0 (or net462) asset on a modern runtime, e.g.
       dotnet test -p:TransportAssetTfm=netstandard2.0 -f net10.0
       That executes the code net462 consumers share, where no .NET Framework runtime is available. -->
  <ItemGroup Condition="'$(TransportAssetTfm)' != ''">
    <ProjectReference Update="..\..\src\Elastic.Transport.VirtualizedCluster\Elastic.Transport.VirtualizedCluster.csproj" SetTargetFramework="TargetFramework=$(TransportAssetTfm)" />
    <!-- Direct, so this asset wins over the one NuGet's restore graph carries in transitively (net10.0). -->
    <ProjectReference Include="..\..\src\Elastic.Transport\Elastic.Transport.csproj" SetTargetFramework="TargetFramework=$(TransportAssetTfm)" />
  </ItemGroup>

</Project>
