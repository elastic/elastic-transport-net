    IEnumerable<Audit> AuditTrail { get; set; }
    Func<VirtualizedCluster> Cluster { get; }
    TransportResponse Response { get; }
    TransportResponse ResponseAsync { get; }
    void ChangeTime(Func<DateTimeOffset, DateTimeOffset> selector)
    Task<Auditor> TraceCall(ClientCall callTrace, int nthCall = 0)
    Task<Auditor> TraceCalls(params ClientCall[] audits)
    Task<Auditor> TraceElasticsearchException(ClientCall callTrace, Action<TransportException> assert)
    Task<Auditor> TraceElasticsearchExceptionOnResponse(ClientCall callTrace, Action<TransportException> assert)
    Task<Auditor> TraceStartup(ClientCall callTrace = null)
