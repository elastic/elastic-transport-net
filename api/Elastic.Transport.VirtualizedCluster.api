namespace Elastic.Transport.VirtualizedCluster.Rules
  sealed class ClientCallRule : RuleBase<ClientCallRule>, IClientCallRule, IRule
    ClientCallRule()
    ClientCallRule AfterSucceeds(RuleOption<Exception, int>? errorState = default)
    ClientCallRule FailAlways(RuleOption<Exception, int>? errorState = default)
    ClientCallRule Fails(RuleOption<TimesHelper.AllTimes, int> times, RuleOption<Exception, int>? errorState = default)
    ClientCallRule SucceedAlways(int? validResponseCode = 200)
    ClientCallRule Succeeds(RuleOption<TimesHelper.AllTimes, int> times, int? validResponseCode = 200)
    ClientCallRule ThrowsAfterSucceeds()

  interface IClientCallRule : IRule

  interface IRule
    RuleOption<Exception, int>? AfterSucceeds { get; set; }
    int ExecuteCount { get; }
    int? OnPort { get; set; }
    Func<string, bool> PathFilter { get; set; }
    RuleOption<Exception, int>? Return { get; set; }
    string ReturnContentType { get; set; }
    byte[] ReturnResponse { get; set; }
    bool Succeeds { get; set; }
    TimeSpan? Takes { get; set; }
    RuleOption<TimesHelper.AllTimes, int> Times { get; set; }
    void RecordExecuted()

  interface ISniffRule : IRule
    VirtualCluster NewClusterState { get; set; }

  sealed class PingRule : RuleBase<PingRule>
    PingRule()
    PingRule FailAlways(RuleOption<Exception, int>? errorState = default)
    PingRule Fails(RuleOption<TimesHelper.AllTimes, int> times, RuleOption<Exception, int>? errorState = default)
    PingRule SucceedAlways(int? validResponseCode = 200)
    PingRule Succeeds(RuleOption<TimesHelper.AllTimes, int> times, int? validResponseCode = 200)

  abstract class RuleBase<TRule> : IRule where TRule : RuleBase<TRule>, IRule
    protected RuleBase()
    TRule OnPath(Func<string, bool> pathPredicate)
    TRule OnPath(string pathContains)
    TRule OnPort(int port)
    TRule ReturnByteResponse(byte[] response, string responseContentType = "application/json")
    TRule ReturnResponse<T>(T response) where T : class
    TRule Takes(TimeSpan span)

  [Union]
  struct RuleOption<TFirst, TSecond> : IUnion
    RuleOption(TFirst value)
    RuleOption(TSecond value)
    readonly object? Value { get; }
    void Match(Action<TFirst> first, Action<TSecond> second)
    T Match<T>(Func<TFirst, T> first, Func<TSecond, T> second)

  sealed class SniffRule : RuleBase<SniffRule>, ISniffRule, IRule
    SniffRule()
    SniffRule FailAlways(RuleOption<Exception, int>? errorState = default)
    SniffRule Fails(RuleOption<TimesHelper.AllTimes, int> times, RuleOption<Exception, int>? errorState = default)
    SniffRule SucceedAlways(VirtualCluster cluster = null)
    SniffRule Succeeds(RuleOption<TimesHelper.AllTimes, int> times, VirtualCluster cluster = null)

  static class TimesHelper
    static readonly TimesHelper.AllTimes Always
    static readonly int Once
    static readonly int Twice
    static int Times(int n)
    class AllTimes
